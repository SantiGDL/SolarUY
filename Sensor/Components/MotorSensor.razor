@implements IAsyncDisposable
@inject Sensor.Servicios.MedicionesCliente Cliente

@code {
    [Parameter] public Guid SesionId { get; set; }
    private readonly CancellationTokenSource _cancelacionInicio = new();
    private Task? _tareaInicio;
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        // El intento de conexión puede seguir después de que termine este render.
        if (firstRender) _tareaInicio = ConectarSensorAsync();
        return Task.CompletedTask;
    }
    private async Task ConectarSensorAsync()
    {
        try { await Cliente.IniciarAsync(SesionId, _cancelacionInicio.Token); }
        catch (OperationCanceledException) when (_cancelacionInicio.IsCancellationRequested) { }
    }
    public async ValueTask DisposeAsync()
    {
        // Si la conexión todavía está arrancando, esperamos que salga antes de liberar el cliente.
        await _cancelacionInicio.CancelAsync();
        if (_tareaInicio is not null) await _tareaInicio;
        await Cliente.DisposeAsync();
        _cancelacionInicio.Dispose();
    }
}
