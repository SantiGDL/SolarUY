<Router AppAssembly="typeof(Program).Assembly" AdditionalAssemblies="new[] { typeof(Sensor._Imports).Assembly }">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized><p>Iniciá sesión para acceder al panel.</p><a href="/auth/login" data-enhance-nav="false">Iniciar sesión</a></NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
