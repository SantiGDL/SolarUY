@inherits LayoutComponentBase

<div class="admin-shell">
    <aside class="admin-sidebar"><NavMenu /></aside>
    <div class="admin-workspace">
        <header class="admin-header">
            <input class="admin-search" type="search" placeholder="Buscar parques, tareas, reportes..." aria-label="Búsqueda, próximamente" disabled />
            <AuthorizeView>
                <Authorized Context="usuario">
                    <div class="admin-identity">
                        <span class="avatar" aria-hidden="true">@(usuario.User.Identity?.Name?.FirstOrDefault().ToString() ?? "U")</span>
                        <div><strong>@usuario.User.Identity?.Name</strong><small>Sesión autenticada</small></div>
                        <form method="post" action="/logout">
                            <AntiforgeryToken />
                            <button class="logout" type="submit">Cerrar sesión</button>
                        </form>
                    </div>
                </Authorized>
            </AuthorizeView>
        </header>
        <main class="admin-content">@Body</main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <button type="button" class="dismiss" aria-label="Cerrar aviso">×</button>
</div>
