@inherits LayoutComponentBase

<div class="admin-shell">
    <aside class="admin-sidebar"><NavMenu /></aside>
    <div class="admin-workspace">
        <header class="admin-header">
            <input class="admin-search" type="search" placeholder="Buscar parques, tareas, reportes..." aria-label="Búsqueda, próximamente" disabled />
            <div class="admin-identity">
                <span class="avatar" aria-hidden="true">AD</span>
                <div><strong>Admin</strong><small>Vista provisional · Sin sesión real</small></div>
                <button class="logout" type="button" disabled>Cerrar sesión</button>
            </div>
        </header>
        <main class="admin-content">@Body</main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <button type="button" class="dismiss" aria-label="Cerrar aviso">×</button>
</div>
