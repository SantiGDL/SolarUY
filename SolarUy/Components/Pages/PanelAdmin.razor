@rendermode InteractiveServer
@page "/admin"
@layout MainLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using SolarUy.Backend.Modulos.Parques.Aplicacion.Contratos
@using SolarUy.Backend.Modulos.Parques.Aplicacion.DTOs
@using SolarUy.Backend.Modulos.Tareas.Aplicacion.Contratos
@using SolarUy.Backend.Modulos.Tareas.Aplicacion.DTOs
@using SolarUy.Backend.Modulos.Tareas.Dominio.Enums
@inject IParquesService ServicioParques
@inject ITareasService ServicioTareas
@inject ILogger<PanelAdmin> Logger

<PageTitle>SolarUy | Panel administrativo</PageTitle>

<section class="admin-hero" aria-labelledby="panel-title">
    <div>
        <p class="eyebrow">PANEL ADMINISTRATIVO</p>
        <h1 id="panel-title">Panel de gestión <span>SolarUy</span></h1>
        <p class="hero-description">Supervisá tus parques solares, consultá la producción y organizá el mantenimiento desde una única plataforma.</p>
    </div>
    <div class="hero-status"><span class="status-dot"></span>Sesión autenticada<span>La gestión de parques está disponible.</span></div>
</section>

@if (!string.IsNullOrWhiteSpace(errorCarga))
{
    <div class="alert alert-danger" role="alert">@errorCarga</div>
}

<section class="summary-grid" aria-label="Resumen de la plataforma">
    <article class="summary-card"><img src="images/IconoPanelSolar.png" alt="" /><div><strong>@(parques?.Count.ToString() ?? "—")</strong><h2>Parques registrados</h2><p>Parques solares disponibles</p></div></article>
    <article class="summary-card"><img src="images/IconoProduccion.png" alt="" /><div><strong>Sin datos</strong><h2>Producción actual</h2><p>Sin mediciones registradas</p></div></article>
    <article class="summary-card"><img src="images/IconoTareas.png" alt="" /><div><strong>@(tareasPendientes?.ToString() ?? "—")</strong><h2>Tareas pendientes</h2><p><a href="/admin/tareas">Ver tareas</a></p></div></article>
</section>

<section class="admin-card quick-section" aria-labelledby="quick-title">
    <p class="eyebrow">ACCESOS RÁPIDOS</p>
    <h2 id="quick-title">Gestión diaria de tu plataforma</h2>
    <div class="quick-grid">
        <a href="/admin/parques" class="quick-card"><img src="images/IconoPanelSolar.png" alt="" /><strong>Gestionar parques</strong><span>Consultá y registrá parques solares.</span><small>Abrir gestión</small></a>
        <a href="/admin/mediciones" target="_top" class="quick-card"><img src="images/IconoProduccion.png" alt="" /><strong>Ver producción</strong><span>Consultá la generación de energía de tus parques.</span><small>Abrir producción</small></a>
        <a href="/admin/tareas" class="quick-card"><img src="images/IconoTareas.png" alt="" /><strong>Gestionar tareas</strong><span>Organizá y seguí las tareas de mantenimiento.</span><small>Abrir gestión</small></a>
        <a href="/admin/historial" class="quick-card" ><img src="images/IconoReportes.png" alt="" /><strong>Reportes</strong><span>Consultá la información y el rendimiento de tus parques.</span><small>Abrir reportes</small></a>
    </div>

</section>

<div class="detail-grid">
    <section class="admin-card assistant" aria-labelledby="assistant-title">
        <div class="section-heading"><h2 class="eyebrow" id="assistant-title">Asistente SolarUy</h2></div>
        <div class="empty-state">
            <img src="images/Consultas.png" alt="" />
            <h3>¿Necesitás ayuda?</h3>
            <p>Consultá sobre la gestión de parques, paneles y producción.</p>
            <span class="assistant-badge">Chatbot</span>
            <p class="assistant-description">Acceso directo al asistente existente.</p>
            <a class="assistant-link" href="/admin/consultas">Abrir asistente</a>
        </div>
    </section>
    <section class="admin-card production" aria-labelledby="production-title">
        <div class="section-heading"><h2 class="eyebrow" id="production-title">PRODUCCIÓN DE ENERGÍA</h2><select aria-label="Período de la gráfica, próximamente" disabled><option>Últimos 7 días</option></select></div>
        <figure><img src="images/GraficaMockup.png" alt="Ejemplo visual de una gráfica de producción de energía; las cifras de la imagen no son datos reales." /><figcaption>Gráfica ilustrativa, sin datos reales</figcaption></figure>
    </section>
</div>

@code {
    private IReadOnlyList<ParqueDto>? parques;
    private int? tareasPendientes;
    private string errorCarga = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            parques = await ServicioParques.ObtenerTodosAsync();
            var tareas = await ServicioTareas.ObtenerTodasAsync();
            tareasPendientes = tareas.Count(tarea => tarea.Estado != EstadoTarea.Completada);
        }
        catch (SolarUy.Backend.Modulos.Parques.Aplicacion.Excepciones.ParquesPersistenciaException exception)
        {
            Logger.LogError(exception, "No se pudo cargar el resumen de parques del panel.");
            errorCarga = "No se pudo cargar el resumen de parques.";
        }
        catch (SolarUy.Backend.Modulos.Tareas.Aplicacion.Excepciones.TareasPersistenciaException exception)
        {
            Logger.LogError(exception, "No se pudo cargar el resumen de tareas del panel.");
            errorCarga = "No se pudo cargar el resumen de tareas.";
        }
    }
}
